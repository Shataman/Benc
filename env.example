# Discord Bot Token (get from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Groq API Key (get from https://console.groq.com/keys - FREE!)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Set the Discord channel ID where the bot should respond (leave empty for all channels)
# DISCORD_CHANNEL_ID=

# Optional: Set the AI model to use (default: llama-3.3-70b-versatile)
# Available models: llama-3.3-70b-versatile, mixtral-8x7b-32768, gemma2-9b-it
# AI_MODEL=llama-3.3-70b-versatile

